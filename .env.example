# API Settings
PROJECT_NAME="TrackIQ Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# LLM Keys
OPENAI_API_KEY="your-openai-key-here"
ANTHROPIC_API_KEY="your-anthropic-key-here"

# Database
DATABASE_URL="sqlite:///./trackiq.db"

# Redis (for checkpointers)
REDIS_URL="redis://localhost:6379"

# LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="trackiq"

# JWT / Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_RANDOM_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
